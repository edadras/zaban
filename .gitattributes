*.zip filter=lfs diff=lfs merge=lfs -text
*.mp3 filter=lfs diff=lfs merge=lfs -text
sources/images/**/*.jpg filter=lfs diff=lfs merge=lfs -text
sources/images/**/*.png filter=lfs diff=lfs merge=lfs -text
sources/images/**/*.ppm filter=lfs diff=lfs merge=lfs -text

# The scanned books. Each is a few hundred megabytes of page images, which
# is more than git should hold inline; the four born-digital vocabulary PDFs
# stay as ordinary blobs because they already are.
sources/grammar_basic_4th.pdf filter=lfs diff=lfs merge=lfs -text
sources/grammar_advanced_3rd.pdf filter=lfs diff=lfs merge=lfs -text
sources/pronunciation_elementary_2nd.pdf filter=lfs diff=lfs merge=lfs -text
sources/pronunciation_intermediate_2nd.pdf filter=lfs diff=lfs merge=lfs -text
sources/pronunciation_advanced_2nd.pdf filter=lfs diff=lfs merge=lfs -text
sources/phrasal_verbs_intermediate_2nd.pdf filter=lfs diff=lfs merge=lfs -text
sources/phrasal_verbs_advanced_2nd.pdf filter=lfs diff=lfs merge=lfs -text
sources/collocations_intermediate_2nd.pdf filter=lfs diff=lfs merge=lfs -text
sources/collocations_advanced_2nd.pdf filter=lfs diff=lfs merge=lfs -text
sources/idioms_intermediate_2nd.pdf filter=lfs diff=lfs merge=lfs -text
sources/idioms_advanced_2nd.pdf filter=lfs diff=lfs merge=lfs -text
sources/grammar_intermediate_5th.pdf filter=lfs diff=lfs merge=lfs -text

# The acted-scene package: the production visual bibles the 3D was modelled
# from, and the modelled kit itself. Both are binary and both are large enough
# that git should hold a pointer rather than the bytes.
sources/boards/*.png filter=lfs diff=lfs merge=lfs -text
backend/public/scene-kit/*.glb filter=lfs diff=lfs merge=lfs -text

# The rendered media. Same reason as the sources: binary, large, and not worth
# storing inline in the history.
backend/storage/app/private/generated/**/*.png filter=lfs diff=lfs merge=lfs -text
backend/storage/app/private/generated/**/*.mp3 filter=lfs diff=lfs merge=lfs -text
