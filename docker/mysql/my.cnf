# ---------------------------------------------------------------------------
# MySQL 8 settings for local development.
#
# The schema is 126 tables with heavy foreign-key use and a handful of very wide
# JSON columns (exercise payloads, session composition, provider metadata), and
# the import writes hundreds of thousands of rows in one transaction. These
# settings target that shape. They are NOT a production configuration — see
# docs/DEPLOYMENT.md.
# ---------------------------------------------------------------------------
[mysqld]

# The content is multilingual by definition: IPA in the pronunciation tables,
# accented headwords, and learner free text. utf8mb4 everywhere, no exceptions.
character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci

# Laravel migrations create a lot of foreign keys and indexes; give the data
# dictionary and buffer pool room so a `migrate:fresh` is not disk-bound.
innodb_buffer_pool_size = 512M
innodb_log_file_size = 128M

# Development durability trade: flush once a second rather than per commit. This
# makes content:import dramatically faster and risks at most one second of writes
# on a crash — acceptable for a laptop, never for production.
innodb_flush_log_at_trx_commit = 2

# ImportCurriculum sends large multi-row inserts and stores whole page texts.
max_allowed_packet = 128M

max_connections = 200

# ONLY_FULL_GROUP_BY is kept: the analytics queries group by design and silently
# picking an arbitrary row would hide a real bug.
sql_mode = "ONLY_FULL_GROUP_BY,STRICT_TRANS_TABLES,NO_ZERO_IN_DATE,NO_ZERO_DATE,ERROR_FOR_DIVISION_BY_ZERO,NO_ENGINE_SUBSTITUTION"

# Surface slow queries during development — the adaptive engines issue some
# genuinely expensive selects and it is better to see them early.
slow_query_log = 1
slow_query_log_file = /var/lib/mysql/slow.log
long_query_time = 1
