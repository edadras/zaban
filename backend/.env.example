########################################################################
# Zaban backend — environment reference
#
# Every variable below is read somewhere in this codebase. The list was
# derived from the code rather than copied from a template: it is the set
# of names matched by env()/getenv() across config/, app/, bootstrap/ and
# database/, plus the small group in the "Broadcasting" and "Hashing"
# sections that the framework's own default config reads (this app does
# not publish config/broadcasting.php or config/hashing.php).
#
# Conventions used here:
#   [required]  the app will not work correctly without it
#   [default: x] omitting the line gives you x
#   Commented-out lines are supported but off by default.
#
# NEVER commit a filled-in .env. Real values live in the deployment's
# secret store; see docs/DEPLOYMENT.md.
########################################################################


# =====================================================================
# Application
# =====================================================================

# Also used as the default prefix for cache, session, Redis and queue keys
# (config/cache.php, config/session.php, config/database.php), so changing
# it on a running system orphans everything already stored under the old
# prefix.
APP_NAME=Zaban

# local | testing | production. Anything other than "local"/"testing"
# should be treated as production by every operational decision below.
APP_ENV=local

# [required] base64 key for the encrypter and for signed URLs. Generate
# with `php artisan key:generate`; never reuse one between environments.
APP_KEY=

# Must be false outside development: true leaks stack traces, environment
# values and SQL through the JSON error responses.
APP_DEBUG=true

# Absolute public URL. Signed media URLs and password-reset links are built
# from it, so a wrong value produces links that silently fail verification.
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Comma-separated list of previous APP_KEYs. Set this during a key rotation
# so data encrypted with the old key can still be decrypted.
# APP_PREVIOUS_KEYS=

# file | cache — where `artisan down` records maintenance mode.
# APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# Only read by `artisan serve`; irrelevant under php-fpm. [default: 1]
# PHP_CLI_SERVER_WORKERS=4


# =====================================================================
# Hashing
# Read by the framework's default config/hashing.php.
# =====================================================================

# bcrypt cost. 12 is the production floor; the test suite overrides it to 4
# in phpunit.xml because hashing dominates test runtime otherwise.
BCRYPT_ROUNDS=12
# bcrypt | argon | argon2id [default: bcrypt]
# HASH_DRIVER=bcrypt
# Re-hash on login when the work factor has been raised. [default: true]
# HASH_VERIFY=true
# ARGON_MEMORY=65536
# ARGON_THREADS=1
# ARGON_TIME=4
# BCRYPT_LIMIT=72


# =====================================================================
# Logging
# =====================================================================

# stack is the multiplexer; LOG_STACK names the channels it writes to.
LOG_CHANNEL=stack
LOG_STACK=single
# debug in development; info or warning in production — the AI layer logs
# at warning on provider failure, and that is what you want to see.
LOG_LEVEL=debug
LOG_DEPRECATIONS_CHANNEL=null
# LOG_DEPRECATIONS_TRACE=false
# Retention for the `daily` channel. [default: 14]
# LOG_DAILY_DAYS=14
# For the `stderr` channel — the right choice in containers.
# LOG_STDERR_FORMATTER=
# LOG_SYSLOG_FACILITY=
# `slack` channel: alert routing for production incidents.
# LOG_SLACK_WEBHOOK_URL=
# LOG_SLACK_USERNAME="Zaban Log"
# LOG_SLACK_EMOJI=":boom:"
# `papertrail` channel.
# LOG_PAPERTRAIL_HANDLER=
# PAPERTRAIL_URL=
# PAPERTRAIL_PORT=


# =====================================================================
# Database
#
# MySQL 8 is the supported engine. The schema is 126 tables with extensive
# foreign keys and JSON columns; SQLite is used only by the test suite
# (phpunit.xml sets DB_CONNECTION=sqlite, DB_DATABASE=:memory:).
# =====================================================================

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=zaban
DB_USERNAME=zaban
DB_PASSWORD=

# A full DSN, which overrides the discrete host/port/database values above.
# DB_URL=

# Unix socket instead of TCP.
# DB_SOCKET=

# utf8mb4 is not optional: the pronunciation tables store IPA and the
# lexicon stores accented headwords.
# DB_CHARSET=utf8mb4
# DB_COLLATION=utf8mb4_unicode_ci

# Path to the CA bundle for TLS connections to a managed MySQL.
# MYSQL_ATTR_SSL_CA=

# SQLite only — the test suite relies on foreign keys being enforced.
# DB_FOREIGN_KEYS=true
# PostgreSQL only.
# DB_SSLMODE=prefer
# SQL Server only.
# DB_ENCRYPT=yes
# DB_TRUST_SERVER_CERTIFICATE=false


# =====================================================================
# Redis
#
# Backs cache, sessions and the six job queues in the Docker stack.
# =====================================================================

# phpredis (the C extension, installed in the Docker image) or predis.
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null
# REDIS_USERNAME=
# REDIS_URL=
# REDIS_DB=0
# Cache lives in its own database so `cache:clear` cannot touch queued jobs.
# REDIS_CACHE_DB=1
# [default: <slug of APP_NAME>-database-] — the key prefix. `make queue-depth`
# discovers it rather than assuming it.
# REDIS_PREFIX=
# REDIS_PERSISTENT=false
# REDIS_CLUSTER=redis
# REDIS_MAX_RETRIES=3
# REDIS_BACKOFF_ALGORITHM=decorrelated_jitter
# REDIS_BACKOFF_BASE=100
# REDIS_BACKOFF_CAP=1000


# =====================================================================
# Cache
# =====================================================================

# redis in the Docker stack; database is the framework default.
CACHE_STORE=redis
# CACHE_PREFIX=
# `database` store.
# DB_CACHE_CONNECTION=
# DB_CACHE_TABLE=cache
# DB_CACHE_LOCK_CONNECTION=
# DB_CACHE_LOCK_TABLE=cache_locks
# `redis` store.
# REDIS_CACHE_CONNECTION=cache
# REDIS_CACHE_LOCK_CONNECTION=default
# `file` store.
# CACHE_STORAGE_DISK=local
# CACHE_STORAGE_PATH=
# `memcached` store.
# MEMCACHED_HOST=127.0.0.1
# MEMCACHED_PORT=11211
# MEMCACHED_USERNAME=
# MEMCACHED_PASSWORD=
# MEMCACHED_PERSISTENT_ID=
# `dynamodb` store.
# DYNAMODB_CACHE_TABLE=cache
# DYNAMODB_ENDPOINT=


# =====================================================================
# Queue
#
# Six named queues carry the background work: default, content, media,
# speech, ai-high, ai-low. See docker/worker/supervisord.conf for why they
# are separate worker pools and docs/ARCHITECTURE.md for what belongs on
# each. NOTE: no jobs are dispatched by the application yet.
# =====================================================================

# redis in the Docker stack. `sync` (used by the test suite) runs jobs
# inline, which is fine for tests and wrong for anything else — an AI call
# would then block the HTTP request.
QUEUE_CONNECTION=redis

# Where failed jobs are recorded. [default: database-uuids]
# QUEUE_FAILED_DRIVER=database-uuids

# `redis` connection.
# REDIS_QUEUE_CONNECTION=default
# REDIS_QUEUE=default
# Must exceed the longest job timeout on that connection or a still-running
# job gets released and run twice. The media pool allows 900s.
# REDIS_QUEUE_RETRY_AFTER=90

# `database` connection.
# DB_QUEUE_CONNECTION=
# DB_QUEUE_TABLE=jobs
# DB_QUEUE=default
# DB_QUEUE_RETRY_AFTER=90

# `beanstalkd` connection.
# BEANSTALKD_QUEUE_HOST=localhost
# BEANSTALKD_QUEUE=default
# BEANSTALKD_QUEUE_RETRY_AFTER=90

# `sqs` connection (uses the AWS_* credentials below).
# SQS_PREFIX=https://sqs.us-east-1.amazonaws.com/your-account-id
# SQS_QUEUE=default
# SQS_SUFFIX=


# =====================================================================
# Session
#
# The mobile client authenticates with Sanctum bearer tokens and is
# stateless, so these matter only for the cookie-based (SPA/admin) path.
# =====================================================================

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# SESSION_EXPIRE_ON_CLOSE=false
# Must be true in production — cookies over plaintext HTTP are a giveaway.
# SESSION_SECURE_COOKIE=true
# SESSION_HTTP_ONLY=true
# lax | strict | none
# SESSION_SAME_SITE=lax
# SESSION_PARTITIONED_COOKIE=false
# `database` driver.
# SESSION_CONNECTION=
# SESSION_TABLE=sessions
# `redis`/`memcached` driver.
# SESSION_STORE=


# =====================================================================
# Authentication (config/auth.php)
# =====================================================================

# AUTH_GUARD=web
# AUTH_MODEL=App\Models\User
# AUTH_PASSWORD_BROKER=users
# AUTH_PASSWORD_RESET_TOKEN_TABLE=password_reset_tokens
# Seconds before a password-reset request may be repeated. [default: 10800]
# AUTH_PASSWORD_TIMEOUT=10800


# =====================================================================
# Sanctum (API authentication)
#
# The Flutter client sends `Authorization: Bearer <token>` and needs none
# of the stateful-domain machinery; that exists for a cookie-authenticated
# browser client on the same site.
# =====================================================================

# Comma-separated hosts that receive session cookies instead of tokens.
# Keep this tight: a wildcard here turns CSRF into a real risk.
# SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:8000

# Prefix stamped onto issued tokens so secret scanners can recognise a
# leaked one. Worth setting in production, e.g. zaban_.
# SANCTUM_TOKEN_PREFIX=


# =====================================================================
# Filesystem / object storage
#
# Book audio (1,162 files, 757 MB), extracted page images and every
# AI-generated asset live on the configured disk.
#
# `s3` additionally requires `composer require league/flysystem-aws-s3-v3`
# — it is a suggested package and is NOT installed yet, so `local` is the
# working default today. The Docker stack runs MinIO on the settings below
# and is ready for the switch.
# =====================================================================

FILESYSTEM_DISK=local

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
# Set for MinIO or any non-AWS S3 endpoint, e.g. http://minio:9000
# AWS_ENDPOINT=
# Public base URL for objects, when they are served directly.
# AWS_URL=
# MinIO needs path-style addressing; AWS S3 does not.
# AWS_USE_PATH_STYLE_ENDPOINT=false


# =====================================================================
# Mail
#
# Used by password reset today. `log` writes the message to the log file
# instead of sending it, which is the right development default.
# =====================================================================

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# null | tls
# MAIL_SCHEME=
# Full DSN, overriding host/port/credentials.
# MAIL_URL=
# MAIL_EHLO_DOMAIN=
# `sendmail` transport.
# MAIL_SENDMAIL_PATH="/usr/sbin/sendmail -bs -i"
# `log` transport: which log channel receives the message.
# MAIL_LOG_CHANNEL=

# Third-party mail transports (config/services.php).
# POSTMARK_API_KEY=
# POSTMARK_MESSAGE_STREAM_ID=
# RESEND_API_KEY=
# The `ses` transport reuses the AWS_* credentials above.

# Slack notification channel (config/services.php).
# SLACK_BOT_USER_OAUTH_TOKEN=
# SLACK_BOT_USER_DEFAULT_CHANNEL=


# =====================================================================
# Broadcasting / websockets
#
# Read by the framework's default config/broadcasting.php. The variables
# work today; the Reverb *server* does not, because laravel/reverb is not
# in composer.json yet. Until it is, leave BROADCAST_CONNECTION=log.
# The docker-compose `reverb` service is behind the `realtime` profile for
# the same reason.
# =====================================================================

BROADCAST_CONNECTION=log
# REVERB_APP_ID=
# REVERB_APP_KEY=
# REVERB_APP_SECRET=
# REVERB_HOST=
# REVERB_PORT=443
# REVERB_SCHEME=https


# =====================================================================
# AI providers (config/ai.php)
#
# One orchestrator (App\AI\AiOrchestrator) fronts every vendor. Each
# capability has an ORDERED chain: the first provider that is configured
# AND reports isAvailable() handles the call, and the rest are fallbacks.
# A vendor outage should degrade a lesson, not break it.
# =====================================================================

# Disk that generated media is mirrored onto. Vendor URLs expire; a lesson
# that renders today must still render next year. [default: local]
AI_STORAGE_DISK=local

# --- Provider chains (comma-separated, in priority order) -------------
# Values must be keys of config('ai.providers'):
#   anthropic | higgsfield | whisper | espeak | placeholder
# AI_CHAIN_TEXT=anthropic
# AI_CHAIN_IMAGE=higgsfield,placeholder
# AI_CHAIN_VIDEO=higgsfield
# AI_CHAIN_AUDIO=higgsfield,espeak
# AI_CHAIN_STT=whisper

# --- Anthropic (text: tutor, grading, item writing, exam scoring) -----
# [required for every AI text feature] Without it AnthropicTextProvider
# reports isAvailable() = false and the text chain is empty.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5
# ANTHROPIC_MAX_TOKENS=8000
# Per-million-token rates used to price each call into the ai_usage cost
# ledger. They are accounting inputs, not billing: keep them in step with
# the vendor's published rates or the spend limits below drift.
# ANTHROPIC_INPUT_COST=5.00
# ANTHROPIC_OUTPUT_COST=25.00

# --- Higgsfield (image, video, audio) ---------------------------------
# Higgsfield ships a CLI rather than a REST API, so this provider shells
# out to the binary and parses its JSON. The binary must be installed and
# authenticated on the host (`higgsfield auth login`); when it is not,
# isAvailable() returns false and the chain falls through.
# Credentials never reach the application — the CLI reads its own token
# file, which is why there is no HIGGSFIELD_API_KEY here.
# HIGGSFIELD_BINARY=higgsfield
# Seconds. Video renders are the long pole; the media queue's job timeout
# (900s, docker/worker/supervisord.conf) must stay above this.
# HIGGSFIELD_TIMEOUT=600
# Path to the CLI's credentials file, passed through as
# HIGGSFIELD_CREDENTIALS_PATH in the subprocess environment.
# HIGGSFIELD_CREDENTIALS_PATH=
# HIGGSFIELD_IMAGE_MODEL=gpt_image_2
# HIGGSFIELD_SCENE_MODEL=gpt_image_2
# HIGGSFIELD_CHARACTER_MODEL=nano_banana_pro
# HIGGSFIELD_VIDEO_MODEL=seedance_2_0
# HIGGSFIELD_AUDIO_MODEL=seed_audio_1_0

# The Higgsfield subprocess inherits HOME (read with getenv in
# App\AI\Providers\HiggsfieldProvider, falling back to /root) because the
# CLI resolves its token file relative to it. Under php-fpm this is often
# unset — set it explicitly if the CLI cannot find its credentials.
# HOME=/home/app

# --- Whisper (speech-to-text) and forced alignment --------------------
# Transcription runs locally on our own hardware so learner voice
# recordings are not sent to a third party by default.
# WHISPER_BINARY=whisper-cli
# [required for speech] Path to the ggml model file. isAvailable() checks
# that this file exists, so speech is simply unavailable without it.
# WHISPER_MODEL_PATH=/models/ggml-base.en.bin
# WHISPER_TIMEOUT=300

# Montreal Forced Aligner (or equivalent) for phoneme-level scoring. When
# it is absent the API reports alignment as unavailable rather than
# inferring phoneme scores from a transcript — a guess dressed up as a
# measurement is worse than an honest gap.
# ALIGNER_BINARY=mfa
# ALIGNER_DICTIONARY=english_us_arpa

# --- espeak-ng (offline TTS fallback) ---------------------------------
# Robotic next to a hosted voice, but a drill with a plain voice still
# teaches and a drill with no audio does not.
# ESPEAK_BINARY=espeak-ng

# --- Spend and volume limits ------------------------------------------
# Fallbacks used when no matching row exists in ai_usage_limits (which
# holds the per-plan and per-user limits). Checked by AiOrchestrator
# before every uncached call.
# AI_DEFAULT_DAILY_REQUESTS=200
# AI_DEFAULT_MONTHLY_COST=50.0


# =====================================================================
# Content validation (config/content.php)
# =====================================================================

# Comma-separated tripwire terms for the automated content check.
# Deliberately narrow: a hit routes the item to a human reviewer, it does
# not delete anything. Empty by default.
# CONTENT_FLAGGED_TERMS=

# Whether generated content may be published without human review.
# [default: false] Leave it false unless you have decided, explicitly,
# that unreviewed material can reach learners.
# CONTENT_AUTO_PUBLISH=false
